(function () {
    'use strict';

    /**
     * Initialize a Timesheet
     */
    var Timesheet = function (container, min, max, data) {
        this.data = [];
        this.min = new Date(min.getFullYear(), 0, 1);
        this.max = max;

        this.parse(data || []);

        if (typeof document !== 'undefined') {
            this.container = (typeof container === 'string') ? document.querySelector('#' + container) : container;
            this.drawSections();
            this.insertData();
        }
    };

    /**
     * Insert data into Timesheet
     */
    Timesheet.prototype.insertData = function () {
        var html = [];
        var widthDay = this.container.querySelector('.scale section').offsetWidth / 365;

        for (var n = 0, m = this.data.length; n < m; n++) {
            var cur = this.data[n];
            var bubble = this.createBubble(widthDay, this.min, cur.start, cur.end);

            var line = [
                '<span style="margin-left: ' + bubble.getStartOffset() + 'px; width: ' + bubble.getWidth() + 'px;" class="bubble bubble-' + (cur.type || 'default') + '" data-duration="' + (cur.end ? Math.round((cur.end - cur.start) / 1000 / 60 / 60 / 24 / 39) : '') + '"></span>',
                '<span class="date">' + bubble.getDateLabel() + '</span> ',
                '<span class="label">' + cur.label + '</span>'
            ].join('');

            html.push('<li>' + line + '</li>');
        }

        this.container.innerHTML += '<ul class="data">' + html.join('') + '</ul>';
    };

    /**
     * Draw section labels
     */
    Timesheet.prototype.drawSections = function () {
        var html = [];

        for (var c = this.min.getFullYear(); c <= this.max.getFullYear(); c++) {
            html.push('<section>' + (Number(c)) + '</section>');
        }

        this.container.className = 'timesheet color-scheme-default';
        this.container.innerHTML = '<div class="scale">' + html.join('') + '</div>';
    };

    /**
     * Parse passed data
     */
    Timesheet.prototype.parse = function (data) {
        for (var n = 0, m = data.length; n < m; n++) {
            var beg = data[n][0];
            var end = data[n].length === 4 ? data[n][1] : null;
            var lbl = data[n].length === 4 ? data[n][2] : data[n][1];
            var cat = data[n].length === 4 ? data[n][3] : data[n].length === 3 ? data[n][2] : 'default';

            if (beg < this.min) {
                this.min = beg;
            }

            if (end && end > this.max) {
                this.max = end;
            } else if (beg > this.max) {
                this.max = beg;
            }

            this.data.push({
                start: beg,
                end: end,
                label: lbl,
                type: cat
            });
        }
    };

    /**
     * Wrapper for adding bubbles
     */
    Timesheet.prototype.createBubble = function (wDay, min, start, end) {
        return new Bubble(wDay, min, start, end);
    };

    /**
     * Timesheet Bubble
     */
    var Bubble = function (wDay, min, start, end) {
        this.min = min;
        this.start = start;
        this.end = end;
        this.widthDay = wDay;
    };

    /**
     * Get bubble's width in pixel
     */
    Bubble.prototype.getWidth = function () {
        const days = this.getDurationInDays();
        return (this.widthDay) * (days == 0 ? 1 : days);
    };

    /**
     * Calculate starting offset for bubble
     */
    Bubble.prototype.getStartOffset = function () {
        let days = Math.ceil((this.start - this.min) / (1000 * 3600 * 24));
        console.log(days);
        return (this.widthDay) * days;
    };  

    /**
     * Get count of all days in Timesheet Bubble
     */
    Bubble.prototype.getDurationInDays = function () {
        var days = 0;

        let difference = this.end - this.start;
        days = Math.ceil(difference / (1000 * 3600 * 24));

        return days;
    }

    /**
     * Get the bubble's label
     */
    Bubble.prototype.getDateLabel = function () {
        return [
            this.start.toLocaleDateString(undefined, {
                month: "short", day: "numeric"
            }),
            this.end.toLocaleDateString(undefined, {
                month: "short", day: "numeric"
            })
        ].join(' - ');
    };

    window.Timesheet = Timesheet;
})();